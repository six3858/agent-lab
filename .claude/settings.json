{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests.py\"" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(experiments/**/result*.md)",
      "Write(experiments/**/result*.md)"
    ]
  }
}
